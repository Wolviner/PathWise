# Copy to .env for local runs. On Hugging Face, add these as Space secrets instead.

# Same Supabase database as PathWise (the pooler URL from PathWise's .env works)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Google AI Studio API key (free tier)
GEMINI_API_KEY=

# Long random string; PathWise must use the same value (RAG_SHARED_SECRET in its .env / Vercel)
RAG_SHARED_SECRET=

# Optional overrides (defaults shown)
# LLM_MODEL=gemini-flash-lite-latest
# FAST_MODEL=gemini-flash-lite-latest
# CHUNK_MODEL=gemini-flash-lite-latest
# JUDGE_MODEL=gemini-flash-lite-latest
# EMBED_MODEL=gemini-embedding-001
# RPM_LIMITS=gemini-3-flash-preview=5,gemini-flash-lite-latest=10,gemini-2.5-flash-lite=10,gemini-embedding-001=0
# CHUNK_WORKERS=2
